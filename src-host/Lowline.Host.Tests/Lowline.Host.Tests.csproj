<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Written by the UI's snapshot contract test. -->
    <None Include="ui-snapshot.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ui-requests.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/__tests__/sidecar-responses.json" Link="sidecar-responses.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lowline.Host\Lowline.Host.csproj" />
  </ItemGroup>

</Project>