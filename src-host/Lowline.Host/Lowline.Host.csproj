<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Published by `npm run build:host` as one self-contained file inside the app's resources. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- SQLite's native library goes inside that file too, unpacked on first run: which SDK publishes it
         decides nothing about what the app ships next to the sidecar. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not hosted by IIS and serves no static files. -->
    <PublishIISAssets>false</PublishIISAssets>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Formbase.Core" Version="0.15.0" />
    <PackageReference Include="Formbase.Sqlite" Version="0.15.0" />
    <PackageReference Include="Formbase.DependencyInjection" Version="0.15.0" />
    <PackageReference Include="Gil" Version="0.7.0" />
    <PackageReference Include="FluxIndex.SDK" Version="0.66.0" />
    <PackageReference Include="FluxIndex.Storage.SQLite" Version="0.66.0" />
  </ItemGroup>

</Project>
