<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Published by `npm run build:host` as one self-contained file inside the app's resources. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Not hosted by IIS and serves no static files. -->
    <PublishIISAssets>false</PublishIISAssets>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

</Project>
