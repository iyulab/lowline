<Project Sdk="Microsoft.NET.Sdk">
  <!-- Restores the packages a release build just packed, from that folder, and calls into the native library: a
       package that restores but cannot load its library fails here, not on a consumer's first call.
       dotnet run -p:LowlineVersion=<version> -p:RestoreAdditionalProjectSources=<folder> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lowline" Version="$(LowlineVersion)" />
    <PackageReference Include="Lowline.Sqlite" Version="$(LowlineVersion)" />
    <PackageReference Include="Lowline.AspNetCore" Version="$(LowlineVersion)" />
  </ItemGroup>
</Project>
