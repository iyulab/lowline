{
  "name": "@iyulab/lowline-form",
  "version": "0.7.0",
  "description": "The Lowline form element: a formdown form whose decided fields are suggested from the records people confirmed, talking to a Lowline host's routes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/lowline.git",
    "directory": "bindings/web"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    }
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/lowline-form.js",
    "./dist/bundle/*"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle": "vite build --config vite.bundle.config.ts"
  },
  "dependencies": {
    "@formdown/ui": "^0.26.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
