<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Lowline.AspNetCore</RootNamespace>
    <Version>0.0.0</Version>
    <Description>ASP.NET Core endpoints for the Lowline engine: AddLowline and MapLowline put a form's suggestions and saves behind two routes.</Description>
    <PackageTags>forms;suggestion;aspnetcore</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lowline\Lowline.csproj" />
  </ItemGroup>
</Project>
