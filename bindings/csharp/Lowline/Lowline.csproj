<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Lowline</RootNamespace>
    <Description>A form engine that learns from the records people confirm: suggestions for a form's decided fields from the records already confirmed, what each rests on, and the account of what a person did with them. The .NET host over the Rust engine.</Description>
    <PackageTags>forms;suggestion;provenance;learning</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Local builds take the native library cargo built in this repository (`cargo build -p lowline-ffi`). -->
  <PropertyGroup>
    <LowlineNativeDirectory Condition="'$(LowlineNativeDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\..\target\debug\</LowlineNativeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(LowlineNativeDirectory)liblowline_native.dylib" Condition="Exists('$(LowlineNativeDirectory)liblowline_native.dylib')" Link="liblowline_native.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(LowlineNativeDirectory)liblowline_native.so" Condition="Exists('$(LowlineNativeDirectory)liblowline_native.so')" Link="liblowline_native.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(LowlineNativeDirectory)lowline_native.dll" Condition="Exists('$(LowlineNativeDirectory)lowline_native.dll')" Link="lowline_native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- The package carries one native library per runtime, which the release build puts under runtimes/<rid>/native/
       (.github/workflows/release.yml). A package without them would restore and then fail on its first call, so
       packing without any stops here. -->
  <!-- The notices of the crates linked into those libraries come with them (notices/config.mjs, written by the release
       build): whoever ships the package must carry them, so packing without them stops here too. -->
  <ItemGroup>
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" Visible="false" />
    <None Include="THIRD-PARTY-NOTICES.txt" Condition="Exists('THIRD-PARTY-NOTICES.txt')" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <Target Name="RequireNativeRuntimes" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)runtimes')" Text="No native libraries under runtimes/&lt;rid&gt;/native/: the package is assembled by the release build." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt')" Text="No THIRD-PARTY-NOTICES.txt for the native libraries' crates: the release build writes it (notices/config.mjs)." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Lowline.Tests" />
    <InternalsVisibleTo Include="Lowline.AspNetCore" />
  </ItemGroup>
</Project>
