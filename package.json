{
  "name": "lowline",
  "version": "0.0.0",
  "private": true,
  "description": "A local form editor that learns from your confirmations",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:host": "dotnet publish src-host/Lowline.Host -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o src-host/publish",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:e2e": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "node e2e/run.mjs",
    "tauri": "tauri",
    "test:host": "dotnet test --project src-host/Lowline.Host.Tests"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@formdown/core": "0.5.1",
    "@formdown/ui": "0.5.1",
    "@iyulab/desktop-compact": "0.4.0",
    "@iyulab/desktop-patterns": "0.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
